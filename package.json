{
  "name": "egg-farm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-node scripts/sync-economy-cli.ts -- --check && tsc --noEmit && vite build && node scripts/check-release-build.mjs dist",
    "test": "vite-node scripts/sync-economy-cli.ts -- --check && vitest run",
    "sync-economy": "vite-node scripts/sync-economy-cli.ts",
    "gen-fixtures": "python3 scripts/gen-sim-fixtures.py",
    "screenshot": "node scripts/screenshot.mjs",
    "smoke": "node scripts/smoke.mjs",
    "preview": "vite preview",
    "build:qa": "vite-node scripts/sync-economy-cli.ts -- --check && tsc --noEmit && vite build --mode qa --outDir dist-qa",
    "check-economy-copy": "node scripts/check-economy-copy.mjs",
    "check-globals": "node scripts/release-globals-browser.mjs"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@types/node": "^20.19.43",
    "playwright-core": "^1.64.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
