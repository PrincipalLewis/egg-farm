+def _read_entries(paths):
+    """Parse ##/### headings that look like D-HOP-/QA-D- IDs -> {id: body text}."""
+    out = {}
+    for path in paths or []:
+        if not path or not os.path.isfile(path):
+            continue
+        text = open(path, encoding='utf-8', errors='replace').read()
+        # split on markdown headings
+        parts = re.split(r'(?m)^(#{1,3}[ \t]+.+)$', text)
+        # parts: [preamble, heading, body, heading, body, ...]
+        i = 1
+        while i < len(parts) - 1:
+            heading, body = parts[i], parts[i + 1]
+            i += 2
+            ids = _DHOP.findall(heading) + _QAD.findall(heading)
+            for eid in ids:
+                out.setdefault(eid, body)
+    return out
+
+
+def _artifact_sha(path):
+    if not path or not os.path.isfile(path):
+        return None
+    return G.sha256(path)
