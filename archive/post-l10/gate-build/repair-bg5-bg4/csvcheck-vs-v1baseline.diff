+def verify_ref(ref, *, kind, artifact_path, decisions_paths, candidate_sha):
+    """Return (verified: bool, reason: str).
+    kind: 'bc_approval' | 'fam_authority' | 'b4_run'
+    artifact_path: candidate CSV (bc_/FAM) or B4 run manifest path (b4_run; may also be parsed from ref via path=)
+    """
+    if not (isinstance(ref, str) and ref.strip()):
+        return False, 'empty ref'
+    entries = _read_entries(decisions_paths)
+    if kind in ('bc_approval', 'fam_authority'):
+        ids = _DHOP.findall(ref)
+        want_prefix = 'D-HOP-'
+    elif kind == 'b4_run':
+        ids = _QAD.findall(ref)
+        want_prefix = 'QA-D-'
+        m = _PATH.search(ref)
+        if m:
+            artifact_path = m.group(1)
+    else:
+        return False, f'unknown kind {kind}'
+    if not ids:
+        return False, f'no {want_prefix} entry ID cited'
+    # use the first cited id of the right family
+    eid = ids[0]
+    if eid not in entries:
+        return False, f'entry {eid} not found in decisions files'
+    body = entries[eid]
+    # authority already enforced by which regex we used + heading must contain that id
+    if kind in ('bc_approval', 'fam_authority') and not eid.startswith('D-HOP-'):
+        return False, 'approval/FAM requires D-HOP entry'
+    if kind == 'b4_run' and not eid.startswith('QA-D-'):
+        return False, 'b4_run_ref requires QA-D entry'
+    art_sha = _artifact_sha(artifact_path)
+    if art_sha is None:
+        return False, f'artifact missing: {artifact_path!r}'
+    if art_sha not in _HEX64.findall(body):
+        return False, f'entry {eid} does not contain artifact sha256'
+    # on-disk match is art_sha by construction of _artifact_sha
+    if kind == 'b4_run':
+        ok, why = _b4_manifest_ok(artifact_path, candidate_sha)
+        if not ok:
+            return False, why
+    else:
+        # bc_/FAM: artifact is the candidate CSV
+        if art_sha != candidate_sha:
+            return False, 'artifact sha != candidate csv sha'
+    return True, f'{eid} ok'
+
