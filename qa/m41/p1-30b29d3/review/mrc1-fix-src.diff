-.tracks-exp,.tracks-exp-out{position:fixed;z-index:27;left:50%;top:72px;transform:translateX(-50%);width:min(296px,calc(100vw - 32px));box-sizing:border-box;background:var(--c-white);border:2px solid var(--c-outline);border-radius:var(--r-md);padding:var(--s-3);color:#3E2C23;box-shadow:var(--shadow);animation:expin .2s var(--ease-pop,ease-out)}
+.tracks-exp,.tracks-exp-out{position:fixed;z-index:27;left:50%;top:72px;transform:translateX(-50%);width:min(296px,calc(100vw - 32px));box-sizing:border-box;background:var(--c-white);border:2px solid var(--c-outline);border-radius:var(--r-md);padding:var(--s-3);color:#3E2C23;box-shadow:var(--shadow);animation:expin .2s cubic-bezier(.34,1,.64,1)} /* HoQA m-RC1-1: --ease-pop's curve with y1 1.56 -> 1 (no scale overshoot past 1, which put the card <=0.27px over the Hens Buy at 375x667); same timing and start, no other change */
