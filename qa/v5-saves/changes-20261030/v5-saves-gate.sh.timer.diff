 step(){ local id=$1 hard=$2; shift 2; if [ -n "${NEEDBUILD:-}" ] && [ "$id" != G1-build ] && ! grep -q "^G1-build | PASS" "$SUM"; then echo "$id | NOT RUN | $hard | build failed" | tee -a "$SUM"; [ $hard = HARD ] && HF=$((HF+1)); return 0; fi; say "START $id"; "$@" > "$R/$id.log" 2>&1; local rc=$?; local res=$([ $rc = 0 ] && echo PASS || echo FAIL)
