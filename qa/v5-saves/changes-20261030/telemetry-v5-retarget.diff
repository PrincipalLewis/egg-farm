+#!/usr/bin/env bash
+# Self-test of g8-schema-ts.mjs on a throw-away git fixture (/tmp) + the real rc/v5 SHAs (read-only git show).
+set -u; D=$(cd "$(dirname "$0")" && pwd); G=/workspace/egg-farm-studio/game; T=$(mktemp -d /tmp/g8.XXXX); P=0; F=0
+ck(){ local n=$1 want=$2; shift 2; out=$(node $D/g8-schema-ts.mjs "$@" 2>&1); rc=$?; if [ $rc = $want ]; then P=$((P+1)); echo "ok   $n (rc=$rc) $(echo "$out" | tail -1)"; else F=$((F+1)); echo "FAIL $n (rc=$rc want $want) $out"; fi; }
+git -C $T init -q r; mkdir -p $T/r/src/telemetry
+names=$(node -e 'console.log(Object.keys(require(process.argv[1]).events).join(" "))' $D/../../spec/telemetry-v062.schema.json)
+{ echo "// fixture"; for n in $names sid fgMs chip_refill chip_sell_all chip_collect chip_manage refill_elsewhere sell_elsewhere collect_elsewhere auto_resume queue_empty basket_empty paused focus_lost cause_changed none; do echo "'$n',"; done; } > $T/r/src/telemetry/schema.ts
+git -C $T/r add -A; git -C $T/r -c user.email=q@x -c user.name=q commit -qm ok; OK=$(git -C $T/r rev-parse HEAD)
+grep -v "'chip_manage'" $T/r/src/telemetry/schema.ts > $T/x && mv $T/x $T/r/src/telemetry/schema.ts; git -C $T/r -c user.email=q@x -c user.name=q commit -qam nocm; NOCM=$(git -C $T/r rev-parse HEAD)
+first=${names%% *}; grep -v "'$first'" $T/r/src/telemetry/schema.ts > $T/x && mv $T/x $T/r/src/telemetry/schema.ts; git -C $T/r -c user.email=q@x -c user.name=q commit -qam noev; NOEV=$(git -C $T/r rev-parse HEAD)
+git -C $T/r rm -q src/telemetry/schema.ts; git -C $T/r -c user.email=q@x -c user.name=q commit -qm rm; RM=$(git -C $T/r rev-parse HEAD)
+ck "positive: fixture names every spec event + envelope + 14 resolved_by" 0 --git $T/r --rc $OK
+ck "negative: chip_manage missing FAILS" 1 --git $T/r --rc $NOCM
+ck "negative: one spec event missing FAILS" 1 --git $T/r --rc $NOEV
+ck "negative: schema.ts absent FAILS" 1 --git $T/r --rc $RM
+ck "real rc/v5 3f582db: FAIL expected (G-8 open)" 1 --git $G --rc 3f582dbfe31a9d309e6b1d0e96a4f77711b333ec
+ck "real rc/v5 e77fc5c (tip): FAIL expected (G-8 open)" 1 --git $G --rc e77fc5c
+echo "RESULT pass=$P fail=$F"; rm -rf $T; [ $F = 0 ]
