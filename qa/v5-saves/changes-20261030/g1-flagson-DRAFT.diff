+#!/usr/bin/env node
+// DRAFT (not pinned) G1-flags-ship-set checker, D-CEO-20261030-09: committed balance.json m4.flags must equal the published ship-set.
+// usage: node g1-ship-set.cjs <rc-balance.json> <ship-set.json>   exit 0 = match, 1 = mismatch / fail closed.
+// ship-set.json: {"m4":{"enabled":0|1,"flags":{<14 keys>:0|1}}} or {"flags":{...}} (enabled optional; required =1 if any flag is 1).
+const fs = require('fs');
+// HoQ 5.1 note F5: exactly these 14 keys (src/config/flags.ts:9-10 at 3f582db).
+const EXPECTED = ['golden','streak','tapCoins','abilities','broody','salesStopped','fatigueCue','pause','rc2Refill','autoRefill','clockWage','breeds','zeroGainUi','bestBuyV2'];
+const die = m => { console.log(m); process.exit(1); };
+const [bp, sp] = process.argv.slice(2);
+if (!bp || !sp) die('usage: g1-ship-set.cjs <balance.json> <ship-set.json>');
+const rd = (p, what) => { let t; try { t = fs.readFileSync(p, 'utf8'); } catch (e) { die(what + ' missing: ' + p + ' (fail closed)'); } try { return JSON.parse(t); } catch (e) { die(what + ' not JSON: ' + p); } };
+const b = rd(bp, 'balance.json'), s = rd(sp, 'ship-set');
+const bf = b && b.m4 && b.m4.flags, sm = s && (s.m4 || s), sf = sm && sm.flags;
+if (!bf || typeof bf !== 'object' || Array.isArray(bf)) die('balance m4.flags missing or not an object');
+if (!sf || typeof sf !== 'object' || Array.isArray(sf)) die('ship-set flags missing or not an object');
+const keyErr = (o, who) => { const k = Object.keys(o), miss = EXPECTED.filter(x => !k.includes(x)), extra = k.filter(x => !EXPECTED.includes(x));
+  return miss.length || extra.length ? who + ' key set != expected 14' + (miss.length ? ' missing=' + miss.join(',') : '') + (extra.length ? ' extra=' + extra.join(',') : '') : null; };
+const errs = [keyErr(sf, 'ship-set'), keyErr(bf, 'balance')].filter(Boolean);
+for (const k of EXPECTED) { if (k in sf && sf[k] !== 0 && sf[k] !== 1) errs.push('ship-set ' + k + '=' + JSON.stringify(sf[k]) + ' not 0|1'); }
+const diff = EXPECTED.filter(k => k in bf && k in sf && bf[k] !== sf[k]).map(k => k + ': balance=' + JSON.stringify(bf[k]) + ' ship-set=' + JSON.stringify(sf[k]));
+if (diff.length) errs.push('flags != ship-set: ' + diff.join('; '));
+const anyOn = EXPECTED.some(k => sf[k] === 1), wantEn = 'enabled' in sm ? sm.enabled : (anyOn ? 1 : undefined);
+if (wantEn !== undefined && b.m4.enabled !== wantEn) errs.push('m4.enabled=' + JSON.stringify(b.m4.enabled) + ' != ship-set ' + wantEn);
+if (errs.length) die(errs.join(' | '));
+console.log('all 14 m4.flags == ship-set (' + EXPECTED.filter(k => sf[k] === 1).length + ' on: ' + (EXPECTED.filter(k => sf[k] === 1).join(',') || 'none') + ')' + (wantEn !== undefined ? '; m4.enabled=' + wantEn : ''));
